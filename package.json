{
  "name": "@send/web",
  "version": "0.1.0",
  "private": true,
  "description": "SEND Next.js web and API server",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3007",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node scripts/migrate-db.ts",
    "deploy:oci": "gh workflow run deploy.yml --repo SendQuiz/SendQuiz-WEB --ref main",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1169.0",
    "@next/env": "16.4.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "24.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
