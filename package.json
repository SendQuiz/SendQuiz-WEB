{
  "name": "@send/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SEND Next.js web and API server",
  "scripts": {
    "dev": "bash scripts/dev-public.sh",
    "dev:local": "next dev -H 0.0.0.0 -p ${PORT:-3006}",
    "dev:server": "next dev -H 0.0.0.0 -p ${PORT:-3006}",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-db.ts",
    "deploy:oci": "gh workflow run deploy.yml --repo SendQuiz/SendQuiz-WEB --ref main"
  },
  "dependencies": {
    "@next/env": "16.2.4",
    "@aws-sdk/client-ses": "^3.1049.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.1",
    "next": "16.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": "24.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
